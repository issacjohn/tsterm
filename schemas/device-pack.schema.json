{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/issacjohn/tsterm/schemas/device-pack.schema.json",
  "title": "TSTerm device pack",
  "description": "A troubleshooting device pack. See docs/DEVICE_PACKS.md for the full guide.",
  "type": "object",
  "required": ["id", "name", "vendor", "family", "categories", "workflows"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Unique lowercase slug."
    },
    "name": { "type": "string", "minLength": 1 },
    "vendor": { "type": "string", "minLength": 1 },
    "family": {
      "type": "string",
      "description": "Firewall, Router, Switch, Wireless, Endpoint, Cloud, or Other."
    },
    "description": { "type": "string" },
    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "extends": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "ID of another device type to inherit."
    },
    "removeWorkflows": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "categories": {
      "type": "array",
      "items": { "$ref": "#/$defs/category" }
    },
    "workflows": {
      "type": "array",
      "items": { "$ref": "#/$defs/workflow" }
    }
  },
  "$defs": {
    "category": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "condition": {
      "type": "object",
      "required": ["var"],
      "additionalProperties": false,
      "properties": {
        "var": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "equals": { "type": "string" },
        "notEquals": { "type": "string" },
        "notEmpty": { "type": "boolean" },
        "empty": { "type": "boolean" }
      }
    },
    "step": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": true,
          "required": [],
          "properties": {
            "command": { "type": "string" },
            "instruction": { "type": "string" },
            "note": { "type": "string" },
            "when": { "$ref": "#/$defs/condition" },
            "unless": { "$ref": "#/$defs/condition" }
          },
          "anyOf": [
            { "required": ["command"] },
            { "required": ["instruction"] }
          ]
        }
      ]
    },
    "choice": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["value"],
          "additionalProperties": true,
          "properties": {
            "value": { "type": "string" },
            "label": { "type": "string" },
            "description": { "type": "string" }
          }
        }
      ]
    },
    "variable": {
      "type": "object",
      "required": ["name", "prompt"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "prompt": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["string", "ip", "ipv4", "ipv6", "int", "port", "choice", "interface", "mac", "hostname"]
        },
        "required": { "type": "boolean" },
        "default": { "type": ["string", "number"] },
        "placeholder": { "type": "string" },
        "help": { "type": "string" },
        "choices": {
          "type": "array",
          "items": { "$ref": "#/$defs/choice" }
        },
        "pattern": { "type": "string" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "sensitive": { "type": "boolean" }
      }
    },
    "reference": {
      "type": "object",
      "required": ["url"],
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "workflow": {
      "type": "object",
      "required": ["id", "title", "category", "steps"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "summary": { "type": "string" },
        "keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "severity": { "type": "string", "enum": ["info", "caution", "danger"] },
        "effect": { "type": "string", "enum": ["read", "debug", "capture", "change"] },
        "requires": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "variables": {
          "type": "array",
          "items": { "$ref": "#/$defs/variable" }
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/step" }
        },
        "verify": {
          "type": "array",
          "items": { "$ref": "#/$defs/step" }
        },
        "cleanup": {
          "type": "array",
          "items": { "$ref": "#/$defs/step" }
        },
        "references": {
          "type": "array",
          "items": { "$ref": "#/$defs/reference" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "effect": { "enum": ["debug", "capture"] }
            },
            "required": ["effect"]
          },
          "then": {
            "required": ["cleanup"],
            "properties": {
              "cleanup": { "minItems": 1 }
            }
          }
        }
      ]
    }
  }
}
