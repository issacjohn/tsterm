{
  "name": "tsterm",
  "productName": "TSTerm",
  "version": "0.2.0",
  "description": "A desktop troubleshooting console with SSH, local shells, device-aware runbooks, inline prediction, a debug guard, and an optional AI assistant that can never run commands.",
  "main": "./out/main/index.js",
  "author": "Issac John",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/issacjohn/tsterm.git"
  },
  "homepage": "https://github.com/issacjohn/tsterm",
  "bugs": {
    "url": "https://github.com/issacjohn/tsterm/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:ai": "node scripts/ai-smoke.mjs",
    "test:debug-guard": "node scripts/ui-debug-close.mjs",
    "test:update": "node scripts/update-smoke.mjs",
    "test:packaged": "node scripts/package-smoke.mjs",
    "icon": "node scripts/make-icon.mjs",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.77.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^2.1.9",
    "ssh2": "^1.17.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2": "^1.15.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.65.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.0.0"
  },
  "build": {
    "appId": "com.tsterm.desktop",
    "productName": "TSTerm",
    "icon": "build/icon.png",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/catalog",
        "to": "catalog"
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dmg"
    },
    "linux": {
      "category": "Network",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true,
    "ssh2@1.17.0": true,
    "electron-winstaller@5.4.0": true
  }
}
